-- Brookhaven Script - Versão Delta Mobile

print("✅ Brookhaven Script Mobile Carregado")

game.StarterGui:SetCore("SendNotification", {
    Title = "Brookhaven Script",
    Text = "ESP + Anti Fling + Anti Sit + Fling carregados!",
    Duration = 8
})

-- ESP Highlights
_G.ESP = true
spawn(function()
    while _G.ESP do
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr \~= game.Players.LocalPlayer and plr.Character then
                if not plr.Character:FindFirstChild("ESP") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP"
                    highlight.FillColor = Color3.fromRGB(255, 0, 255)
                    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = plr.Character
                end
            end
        end
        wait(2)
    end
end)

-- Anti Fling
_G.AntiFling = true
game:GetService("RunService").Heartbeat:Connect(function()
    if _G.AntiFling then
        local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
            root.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end
end)

-- Anti Sit
_G.AntiSit = true
spawn(function()
    while _G.AntiSit do
        local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            hum.Sit = false
        end
        wait(0.15)
    end
end)

-- Fling (Clique no jogador)
game.Players.LocalPlayer:GetMouse().Button1Down:Connect(function()
    local target = game.Players.LocalPlayer:GetMouse().Target
    if target and target.Parent:FindFirstChild("Humanoid") then
        local root = target.Parent:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = Vector3.new(math.random(-2000,2000), 1300, math.random(-2000,2000))
            print("Fling em: " .. target.Parent.Name)
        end
    end
end)

print("✅ Todas funções ativadas!")
