-- // Rayfield Loader Atualizado
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Brookhaven RP Script",
    LoadingTitle = "Carregando...",
    LoadingSubtitle = "Versão Corrigida",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "BrookhavenHub",
        FileName = "Config"
    }
})

local Main = Window:CreateTab("Principal", 4483362458)
local Visual = Window:CreateTab("Visual", 4483362458)
local Troll = Window:CreateTab("Troll", 4483362458)

-- ==================== ESP ====================
Visual:CreateToggle({
    Name = "ESP Highlights",
    CurrentValue = false,
    Callback = function(Value)
        _G.ESP = Value
        if Value then
            for _, v in pairs(game.Players:GetPlayers()) do
                if v \~= game.Players.LocalPlayer and v.Character then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP"
                    highlight.FillColor = Color3.fromRGB(255, 0, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = v.Character
                end
            end
        else
            for _, v in pairs(game.Players:GetPlayers()) do
                if v.Character and v.Character:FindFirstChild("ESP") then
                    v.Character.ESP:Destroy()
                end
            end
        end
    end,
})

-- ==================== ANTI FLING ====================
Main:CreateToggle({
    Name = "Anti Fling",
    CurrentValue = false,
    Callback = function(Value)
        _G.AntiFling = Value
        if Value then
            game:GetService("RunService").Heartbeat:Connect(function()
                if _G.AntiFling and game.Players.LocalPlayer.Character then
                    local root = game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                        root.AssemblyAngularVelocity = Vector3.new(0,0,0)
                    end
                end
            end)
        end
    end,
})

-- ==================== ANTI SIT ====================
Main:CreateToggle({
    Name = "Anti Sit",
    CurrentValue = false,
    Callback = function(Value)
        _G.AntiSit = Value
        spawn(function()
            while _G.AntiSit and game.Players.LocalPlayer.Character do
                local hum = game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
                if hum then
                    hum.Sit = false
                end
                wait(0.05)
            end
        end)
    end,
})

-- ==================== FLING (Melhorado) ====================
local flingConnection = nil

Troll:CreateToggle({
    Name = "Fling (Segure no Alvo)",
    CurrentValue = false,
    Callback = function(Value)
        if Value then
            Rayfield:Notify({Title = "Fling", Content = "Clique em um jogador para flingar ele!", Duration = 4})
            
            flingConnection = game.Players.LocalPlayer:GetMouse().Button1Down:Connect(function()
                local target = game.Players.LocalPlayer:GetMouse().Target
                if target and target.Parent:FindFirstChild("Humanoid") then
                    local root = target.Parent:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.Velocity = Vector3.new(math.random(-999,999), 999, math.random(-999,999))
                        root.AssemblyLinearVelocity = Vector3.new(math.random(-2000,2000), 1500, math.random(-2000,2000))
                    end
                end
            end)
        else
            if flingConnection then
                flingConnection:Disconnect()
            end
        end
    end,
})

Troll:CreateButton({
    Name = "Fling All (Forte)",
    Callback = function()
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr \~= game.Players.LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local r = plr.Character.HumanoidRootPart
                r.Velocity = Vector3.new(0, 500, 0)
                r.AssemblyLinearVelocity = Vector3.new(math.random(-1200,1200), 800, math.random(-1200,1200))
            end
        end
    end,
})

Rayfield:Notify({
    Title = "Script Carregado com Sucesso!",
    Content = "Teste as funções agora",
    Duration = 5
})
